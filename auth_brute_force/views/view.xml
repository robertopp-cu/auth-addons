<odoo>

    <!-- Model: res.authentication.attempt -->
    <record id="view_res_authentication_attempt_tree" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <list
                decoration-warning="result == 'failed'"
                decoration-danger="result == 'banned'"
                create="0"
            >
                <field name="create_date" />
                <field name="remote" />
                <field name="login" />
                <field name="result" />
            </list>
        </field>
    </record>

    <record id="view_res_authentication_attempt_form" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        name="action_unban"
                        type="object"
                        string="Set to unbanned"
                        invisible="result != 'banned'"
                    />
                    <button
                        name="action_whitelist_add"
                        type="object"
                        string="Add remote to whitelist"
                        invisible="whitelisted"
                    />
                    <button
                        name="action_whitelist_remove"
                        type="object"
                        string="Remove remote from whitelist"
                        invisible="not whitelisted"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="create_date" />
                        <field name="result" />
                        <field name="login" />
                        <field name="remote" />
                        <field name="remote_metadata" invisible="not remote_metadata" />
                        <field name="whitelisted" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_authentication_attempt_graph" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <graph>
                <field name="create_date" />
                <field name="result" />
            </graph>
        </field>
    </record>

    <record id="view_res_authentication_attempt_search" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="login" />
                <field name="remote" />
                <filter
                    name="filter_no_success"
                    string="Without Success"
                    domain="[('result', '!=', 'successful')]"
                />
                <filter
                    name="filter_banned"
                    string="Banned"
                    domain="[('result', '=', 'banned')]"
                />
                <filter
                    name="filter_failed"
                    string="Failed"
                    domain="[('result', '=', 'failed')]"
                />
                <filter
                    name="filter_unbanned"
                    string="Unbanned"
                    domain="[('result', '=', 'unbanned')]"
                />
                <filter
                    name="filter_successful"
                    string="Successful"
                    domain="[('result', '=', 'successful')]"
                />
            </search>
        </field>
    </record>

    <!-- Model: res.authentication.ban -->
    <record id="view_res_authentication_ban_tree" model="ir.ui.view">
        <field name="model">res.authentication.ban</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'active'" decoration-muted="state != 'active'" create="0">
                <field name="date_start" />
                <field name="date_end" />
                <field name="remote" />
                <field name="login" />
                <field name="count" />
                <field name="duration" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_res_authentication_ban_form" model="ir.ui.view">
        <field name="model">res.authentication.ban</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        name="action_unban"
                        type="object"
                        string="Unban"
                        invisible="state != 'active'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="remote" />
                            <field name="login" />
                            <field name="count" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="duration" />
                            <field name="unbanned" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_authentication_ban_search" model="ir.ui.view">
        <field name="model">res.authentication.ban</field>
        <field name="arch" type="xml">
            <search>
                <field name="remote" />
                <field name="login" />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('unbanned', '=', False), ('date_end', '&gt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"
                />
                <filter
                    name="filter_remote_wide"
                    string="Whole remote"
                    domain="[('login', '=', False)]"
                />
            </search>
        </field>
    </record>

</odoo>
